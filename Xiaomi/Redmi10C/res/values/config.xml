<?xml version="1.0" encoding="utf-8"?>
<resources>
<!--
    Universal boolean overrides — safe for any device.
    
    Device-specific values (Samsung UDFPS, AOD, burn-in, VoLTE, etc.)
    are now controlled via config.env → auto-generated in generated.xml.
    
    For other device-specific bools (power decoupling, display blanks after
    doze, audio jack, camera sound, VoLTE carrier flags, etc.):
      - Add them to config.env (see OPTIONAL STOCK VALUES section)
      - Or extract from your stock overlay APKs following the TrebleDroid guide:
        https://github.com/TrebleDroid/treble_experimentations/wiki/How-to-create-an-overlay%3F
-->

    <!-- Display: Show navigation bar for gesture nav -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Display: Screen wake on unplug -->
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- Connectivity: Hot-swappable SIM -->
    <bool name="config_hotswapCapable">true</bool>

    <!-- Security: Lock screen rotation -->
    <bool name="config_enableLockScreenRotation">true</bool>

    <!-- Multi-user support -->
    <bool name="config_enableMultiUserUI">true</bool>

    <!-- Cell broadcast app links -->
    <bool name="config_cellBroadcastAppLinks">true</bool>

    <!-- Wifi Display -->
    <bool name="config_enableWifiDisplay">true</bool>

    <!-- Performance: Pin home app in memory (safe for all devices) -->
    <bool name="config_pinnerHomeApp">true</bool>

<!--
    Framework resource overrides — universal AOSP defaults.
    
    =========================================================================
    ⚠️ IMPORTANT: Device-specific values go in config.env, NOT here!
    =========================================================================
    
    For your device-specific overlay config:
      1. Run ./setup.sh to get the Android 13 framework-res.apk
      2. Extract stock overlay APKs from your device:
           /system/product/overlay/framework-res__auto_generated_rro_product.apk
           /system/vendor/overlay/framework-res__auto_generated_rro_vendor.apk
      3. Decompile with apktool and compare values (see README for guide link)
      4. Put the product-specific values in a file at project root:
           stock_overlay.xml
         The build will automatically include it.
    
    For values controlled by config.env (UDFPS, AOD, brightness, etc.):
      Edit config.env → build.sh generates res/values/generated.xml
    
    For simple bool/integer/string overrides:
      Uncomment the corresponding OPTIONAL STOCK VALUES in config.env
-->

    <!-- ============================================================
         DOZE / AOD (Universal AOSP service component)
         ============================================================ -->
    <string name="config_dozeComponent" translatable="false">
        com.android.systemui/com.android.systemui.doze.DozeService
    </string>

    <!-- ============================================================
         POWER / BATTERY (Universal default levels)
         ============================================================ -->
    <integer name="config_criticalBatteryWarningLevel">5</integer>
    <integer name="config_lowBatteryWarningLevel">15</integer>
    <integer name="config_lowBatteryCloseWarningBump">3</integer>

    <!-- ============================================================
         MULTIUSER
         ============================================================ -->
    <integer name="config_multiuserMaximumUsers">4</integer>

    <!-- ============================================================
         AUTO-BRIGHTNESS DEBOUNCE (AOSP defaults)
         ============================================================ -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">2000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">6000</integer>
    <integer name="config_lightSensorWarmupTime">200</integer>

    <!-- ============================================================
         ⬇ PLACE YOUR EXTRACTED STOCK VALUES BELOW ⬇
         
         To extract your device-specific values:
         1. Follow the guide at the top of this file
         2. Extract values from your stock product overlay APK
         3. Place them here, or better: create stock_overlay.xml
         
         Common values to extract:
         - config_radio_access_family (e.g., "GSM|WCDMA|LTE|NR")
         - config_biometric_sensors (fingerprint sensor config)
         - config_mainBuiltInDisplayCutout (notch/cutout path)
         - skip_restoring_network_selection (Samsung RIL)
         - config_switch_phone_on_voice_reg_state_change
         - config_dozeUdfpsLongPressSensorType
         ============================================================ -->

<!--
    Auto-generated by build.sh from config.env - DO NOT EDIT BY HAND.
    Edit config.env and re-build. Overrides values in config.xml, bools.xml,
    and dimens.xml based on your config.env settings.
-->

    <bool name="config_dozeAfterScreenOffByDefault">true</bool>
    <bool name="config_dozePulsePickup">true</bool>

    <bool name="config_supportDoubleTapWake">true</bool>

    <bool name="config_device_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>
    <bool name="config_device_wfc_ims_available">true</bool>

    <string name="config_displayLightSensorType" translatable="false">android.sensor.light</string>

    <integer name="config_screenBrightnessDim">15</integer>
    <integer name="config_screenBrightnessDark">3</integer>
    <integer name="config_screenBrightnessDoze">60</integer>
    <integer name="config_screenBrightnessSettingMinimum">0</integer>
    <integer name="config_screenBrightnessSettingDefault">128</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>

    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">.0</item>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">.0</item>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">.0</item>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">.0</item>

    <string name="config_mainBuiltInDisplayCutout" translatable="false">M 0,0 H -40 V 49 H 40 V 0 H 0 Z</string>

    <bool name="config_fillMainBuiltInDisplayCutout">false</bool>

    <bool name="config_supportAudioSourceUnprocessed">true</bool>

    <bool name="config_carrier_volte_available">true</bool>

    <bool name="config_carrier_vt_available">true</bool>

    <bool name="config_carrier_wfc_ims_available">true</bool>

    <bool name="skip_restoring_network_selection">true</bool>

    <integer name="config_defaultRefreshRate">60</integer>
    <integer name="config_defaultPeakRefreshRate">60</integer>

